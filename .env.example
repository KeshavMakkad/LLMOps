# Required: Gemini API key (free tier works)
GEMINI_API_KEY=
# Optional locally (falls back to SQLite). Neon pooled URL for the deployed service / CI gate.
DATABASE_URL=
# Auth for POST /v1/answer (leave empty locally)
FRUGAL_API_TOKEN=
# Model calls allowed per day by the service (protects the free quota; cache hits are free)
FRUGAL_MAX_DAILY_CALLS=300
# Optional tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://jp.cloud.langfuse.com
